# Copy this file to .env and fill in real values there.
# Values in .env.example are examples only and are not loaded by the app.

# Runtime
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
REALTIME_SEND_TIMEOUT_SECONDS=2
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
MAX_UPLOAD_BYTES=26214400
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_TTS_CHARS=2000

# Docker
DOCKER_VOLUME_DIRECTORY=.

# LLM
ARK_API_KEY=
MODEL=
BASE_URL=
GRADE_MODEL=gpt-4.1

# Embedding
EMBEDDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_HTTP_RETRIES=2

# Rerank
RERANK_MODEL=
RERANK_BINDING_HOST=
RERANK_API_KEY=

# Vision
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT=45

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection

# Database / Cache
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/langchain_app
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=supermew
REDIS_CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=2

# Auth
JWT_SECRET_KEY=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000
MIN_PASSWORD_LENGTH=6
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# RAG / Retrieval
RAG_FAST_MODE=false
RAG_GRADING_ENABLED=true
RAG_REWRITE_ENABLED=true
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
KEYWORD_FALLBACK_SCAN_LIMIT=10000
RETRIEVAL_CANDIDATE_MULTIPLIER=2
AGENT_STREAM_HEARTBEAT_SECONDS=4
AGENT_STREAM_MAX_SECONDS=300

# Weather
WEATHER_PROVIDER=openmeteo,amap
WEATHER_TIMEOUT_SECONDS=10
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_DISTRICT_API=https://restapi.amap.com/v3/config/district
AMAP_API_KEY=
OPEN_METEO_GEOCODING_API=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_API=https://api.open-meteo.com/v1/forecast

# Logistics
LOGISTICS_PROVIDER=kdniao,aliyun,kuaidi100
LOGISTICS_TIMEOUT_SECONDS=10
KDNIAO_LOGISTICS_API=https://api.kdniao.com/Ebusiness/EbusinessOrderHandle.aspx
KDNIAO_EBUSINESS_ID=
KDNIAO_API_KEY=
KDNIAO_REQUEST_TYPE=8002
ALIYUN_LOGISTICS_API=https://wuliu.market.alicloudapi.com/kdi
ALIYUN_LOGISTICS_APPCODE=
KUAIDI100_QUERY_API=https://poll.kuaidi100.com/poll/query.do
KUAIDI100_AUTO_API=https://www.kuaidi100.com/autonumber/auto
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=

# Aliyun ASR / TTS
ALIYUN_API_KEY=
